generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(LEARNER)
  department    String?
  jobTitle      String?
  avatarUrl     String?
  weeklyEmailSummary Boolean @default(true)
  learningPace  String   @default("balanced")
  onboardingComplete Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress      Progress[]
  gamification  UserGamification?
  achievements  UserAchievement[]
  streakHistory StreakRecord[]
  xpHistory     XPTransaction[]
  scenarioResponses ScenarioResponse[]
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Int?
  completedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  difficulty  String   @default("beginner")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content     LessonContent?
  progress    Progress[]
}

model LessonContent {
  id        String   @id @default(cuid())
  lessonId  String   @unique
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  steps     Json
}

// === Gamification Models ===

model UserGamification {
  id               String    @id @default(cuid())
  userId           String    @unique
  totalXP          Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  streakMultiplier Float     @default(1.0)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  sourceId  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StreakRecord {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// === Achievement Models ===

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  iconEmoji   String   @default("🏆")
  category    String
  xpReward    Int      @default(50)
  criteria    Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// === Scenario Models ===

model Scenario {
  id         String   @id @default(cuid())
  lessonId   Int
  title      String
  riskLevel  String   // HIGH, LIMITED, MINIMAL, UNACCEPTABLE
  situation  String   @db.Text
  prompt     String
  options    Json     // Array of {id, label, description, impacts, feedback, isOptimal}
  proTip     String   @db.Text
  xpReward   Int      @default(30)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  responses  ScenarioResponse[]

  @@unique([lessonId])
}

model ScenarioResponse {
  id           String   @id @default(cuid())
  userId       String
  scenarioId   String
  chosenOption String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario     Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
}
