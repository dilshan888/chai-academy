generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

enum NotificationType {
  LESSON_COMPLETE
  LEVEL_UP
  BADGE_EARNED
  STREAK_MILESTONE
  SYSTEM
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique // e.g., 'GAMIFICATION_ENABLED'
  value String // 'true' or 'false'
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(LEARNER)
  department    String?
  jobTitle      String?
  avatarUrl     String?
  weeklyEmailSummary Boolean @default(true)
  learningPace  String   @default("balanced")
  onboardingComplete Boolean @default(false)
  optOutOfLeaderboard Boolean @default(false)
  gdprConsentAt       DateTime?
  privacyPolicyVersion String?
  marketingConsent    Boolean  @default(false)
  preTestCompleted    Boolean  @default(false)
  postTestCompleted   Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress      Progress[]
  gamification  UserGamification?
  achievements  UserAchievement[]
  streakHistory StreakRecord[]
  xpHistory     XPTransaction[]
  scenarioResponses ScenarioResponse[]
  notifications     Notification[]
  assessments   AssessmentResponse[]
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Int?
  completedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// === Curriculum Structure: Phase → Module → Lesson → Blocks ===

model Phase {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  duration    String?
  xpReward    Int      @default(500)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  phaseId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([phaseId])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  difficulty  String   @default("beginner")
  sortOrder   Int      @default(0)
  moduleId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  content     LessonContent?
  progress    Progress[]
  scenario    Scenario?

  @@index([moduleId])
}

model LessonContent {
  id        String   @id @default(cuid())
  lessonId  String   @unique
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  steps     Json
}

// === Gamification Models ===

model UserGamification {
  id               String    @id @default(cuid())
  userId           String    @unique
  totalXP          Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  streakMultiplier Float     @default(1.0)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  sourceId  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StreakRecord {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// === Achievement Models ===

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  iconEmoji   String   @default("🏆")
  category    String
  xpReward    Int      @default(50)
  criteria    Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// === Scenario Models ===

model Scenario {
  id         String   @id @default(cuid())
  lessonId   String   @unique
  title      String
  riskLevel  String   // HIGH, LIMITED, MINIMAL, UNACCEPTABLE
  situation  String   @db.Text
  prompt     String
  options    Json     // Array of {id, label, description, impacts, feedback, isOptimal}
  proTip     String   @db.Text
  xpReward   Int      @default(30)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  responses  ScenarioResponse[]
}

model ScenarioResponse {
  id           String   @id @default(cuid())
  userId       String
  scenarioId   String
  chosenOption String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario     Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
}

// === Notification Model ===

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// === Research Assessment Models ===

enum AssessmentType {
  PRE_TEST
  POST_TEST
}

model AssessmentResponse {
  id           String         @id @default(cuid())
  userId       String
  type         AssessmentType
  answers      Json           // Array of { questionId, answer }
  submittedAt  DateTime       @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

